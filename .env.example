# Copy to .env and fill in real values. Do NOT commit the .env file.

# Server
PORT=5000

# Supabase — SERVICE_ROLE_KEY has admin power; never expose to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# JWT — MUST be at least 32 characters of high-entropy random bytes.
# Generate: `node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"`
JWT_SECRET=replace-me-with-32+-chars-of-random-entropy

# CORS — comma-separated allowlist of origins permitted to call the API from
# a browser. Leave empty to allow only non-browser clients (e.g. native apps).
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# Brevo (transactional email)
BREVO_API_KEY=replace-me
SENDER_EMAIL=no-reply@example.com
SENDER_NAME=AI Study Buddy
